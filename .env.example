# ─── The Tyre Mall — environment variables ───────────────────────────────────
# Copy to .env.local for local dev. In production, set these in
# Vercel → Project → Settings → Environment Variables.

# Public site URL (used to build PayFast return/cancel/notify URLs)
NEXT_PUBLIC_SITE_URL=https://shop-thetyremall.vercel.app

# ── PayFast ──────────────────────────────────────────────────────────────────
# SANDBOX first (public PayFast test credentials). The passphrase MUST match
# the one set on the PayFast sandbox account, or the signature is rejected.
PAYFAST_SANDBOX=true
PAYFAST_MERCHANT_ID=10004002
PAYFAST_MERCHANT_KEY=q1cd2rdny4a53
PAYFAST_PASSPHRASE=payfast
# When going live: set PAYFAST_SANDBOX=false and use the real merchant_id/key/
# passphrase from the PayFast dashboard (Settings → Integration).

# ── Email — Resend (RECOMMENDED for Vercel) ──────────────────────────────────
# If RESEND_API_KEY is set, the app sends via Resend's HTTP API (reliable on
# serverless; no SMTP ports, no Microsoft basic-auth blocks) and ignores the
# SMTP_* settings below. Setup (~10 min):
#   1. Sign up free at resend.com.
#   2. Add domain thetyremall.co.za → add the DNS records Resend shows (SPF/DKIM).
#   3. Create an API key → paste it here (and into Vercel) as RESEND_API_KEY.
# MAIL_FROM / SHOP_EMAIL below still apply (keep shop@thetyremall.co.za once the
# domain is verified). Until the domain is verified, send from onboarding@resend.dev.
RESEND_API_KEY=

# ── Email (SMTP) — Microsoft 365 / Outlook (fallback) ────────────────────────
# Only used when RESEND_API_KEY is empty. Mailbox shop@thetyremall.co.za is on
# Microsoft 365. NOTE: M365 often blocks SMTP logins from cloud servers (535
# error) even with the correct password — Resend above avoids this.
#   • SMTP AUTH must be enabled for this mailbox (Microsoft 365 admin →
#     Users → shop@ → Mail → "Manage email apps" → tick Authenticated SMTP).
#     If the WP plugin already sends mail, it's already enabled.
#   • If the mailbox has MFA, SMTP_PASS must be an *app password*, not the
#     normal login password.
#   • MAIL_FROM must be the same address as SMTP_USER (M365 blocks sending
#     "from" an address you haven't authenticated as / been granted send-as).
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false          # false = STARTTLS (port 587); true = SSL (port 465)
SMTP_USER=shop@thetyremall.co.za
SMTP_PASS=                 # set in Vercel env vars — never commit the real password
MAIL_FROM=The Tyre Mall <shop@thetyremall.co.za>
SHOP_EMAIL=shop@thetyremall.co.za
# TESTING ONLY — copy every outgoing email to these (comma-separated) so the
# look & feel can be reviewed. Set EMAIL_CC= (empty) to turn off once signed off.
# If unset, it defaults to tracy@iheartdigital.co.za, shop@thetyremall.co.za.
EMAIL_CC=tracy@iheartdigital.co.za, shop@thetyremall.co.za

# ── Headless WooCommerce ─────────────────────────────────────────────────────
# Reading live stock & prices uses the public Store API (no keys needed).
# Writing paid orders back to Woo (so it decrements stock + shows in the admin)
# needs REST API keys: WooCommerce → Settings → Advanced → REST API → Add key
# (Permissions: Read/Write). Then paste the Consumer key & secret here.
WOO_SITE_URL=https://thetyremall.co.za
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# ── Order store (Vercel KV / Upstash Redis) ──────────────────────────────────
# Needed in production so the order placed at checkout is still there when
# PayFast's ITN webhook calls back. Add a KV store in the Vercel dashboard
# (Storage → KV) and it auto-populates these. Local dev falls back to .data/orders.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Custom backend (database + admin) ────────────────────────────────────────
# Local dev uses a SQLite file; production uses Turso (libsql://…) + a token.
DATABASE_URL=file:.data/ttm.db
DATABASE_AUTH_TOKEN=
# Admin login (shop.thetyremall.co.za/admin)
ADMIN_PASSWORD=change-me-to-a-strong-password
SESSION_SECRET=change-me-to-a-long-random-string

# ── Scheduled jobs (Vercel Cron) ─────────────────────────────────────────────
# Shared secret so only Vercel Cron can trigger /api/cron/* (recovery + weekly).
CRON_SECRET=change-me-to-a-long-random-string

# ── Misc (all optional) ──────────────────────────────────────────────────────
# SITE_URL — absolute URL used in emails; defaults to https://thetyremall.co.za
SITE_URL=https://shop-thetyremall.vercel.app
# Credit link in the abandoned-cart email footer (kept from the WP plugin)
IHD_CREDIT_URL=https://www.iheartdigital.co.za
# Optional RSS/Atom feed for the blog/news section
NEWS_FEED_URL=
